@@ -311,8 +313,14 @@ void PanelAnimation::start() {
 	RoundShadowAnimation::start(_finalWidth, _finalHeight, _finalImage.devicePixelRatio());
 	auto checkCorner = [this](const Corner &corner) {
 		if (!corner.valid()) return;
-		if (_startWidth >= 0) Assert(corner.width <= _startWidth);
-		if (_startHeight >= 0) Assert(corner.height <= _startHeight);
+		// Liquid glass fork: rounder corners may not fit a tiny start size,
+		// start a bit larger instead of failing.
+		if (_startWidth >= 0 && corner.width > _startWidth) {
+			_startWidth = std::min(corner.width, _finalInnerWidth);
+		}
+		if (_startHeight >= 0 && corner.height > _startHeight) {
+			_startHeight = std::min(corner.height, _finalInnerHeight);
+		}
 		Assert(corner.width <= _finalInnerWidth);
 		Assert(corner.height <= _finalInnerHeight);
 	};
@@ -502,7 +510,32 @@ auto PanelAnimation::paintFrame(
 	//	frameInts += _frameIntsPerLineAdded;
 	//}
 
-	p.drawImage(style::rtlpoint(x + (outerLeft / pixelRatio), y + (outerTop / pixelRatio), outerWidth), _frame, QRect(outerLeft, outerTop, outerRight - outerLeft, outerBottom - outerTop));
+	const auto target = style::rtlpoint(x + (outerLeft / pixelRatio), y + (outerTop / pixelRatio), outerWidth);
+	const auto source = QRect(outerLeft, outerTop, outerRight - outerLeft, outerBottom - outerTop);
+	// Liquid glass fork: the panel springs out of its corner,
+	// 93% -> ~101% -> 100%, settling exactly when the animation ends.
+	const auto spring = (dt < 1.)
+		? (1. - 0.07 * std::exp(-6. * dt) * std::cos(11. * dt))
+		: 1.;
+	if (spring != 1.) {
+		const auto left = (_origin == Origin::TopLeft)
+			|| (_origin == Origin::BottomLeft);
+		const auto top = (_origin == Origin::TopLeft)
+			|| (_origin == Origin::TopRight);
+		const auto origin = QPointF(style::rtlpoint(
+			x + (left ? _finalInnerLeft : _finalInnerRight) / pixelRatio,
+			y + (top ? _finalInnerTop : _finalInnerBottom) / pixelRatio,
+			outerWidth));
+		p.save();
+		p.setRenderHint(QPainter::SmoothPixmapTransform);
+		p.translate(origin);
+		p.scale(spring, spring);
+		p.translate(-origin);
+		p.drawImage(target, _frame, source);
+		p.restore();
+	} else {
+		p.drawImage(target, _frame, source);
+	}
 
 	return state;
 }
