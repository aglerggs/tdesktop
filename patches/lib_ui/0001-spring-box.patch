@@ -30,6 +32,28 @@ void BoxContentDivider::paintEvent(QPaintEvent *e) {
 	QPainter p(this);
 
 	p.fillRect(e->rect(), _st.bg);
+
+	// Liquid glass fork: the sections around a divider look like cards,
+	// their ends are rounded into the divider instead of shadow lines.
+	const auto radius = std::clamp((height() - 2) / 2, 0, 12);
+	if (radius >= 3) {
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBg);
+		if (_parts & RectPart::Top) {
+			p.drawRoundedRect(
+				QRect(0, -radius, width(), 2 * radius),
+				radius,
+				radius);
+		}
+		if (_parts & RectPart::Bottom) {
+			p.drawRoundedRect(
+				QRect(0, height() - radius, width(), 2 * radius),
+				radius,
+				radius);
+		}
+		return;
+	}
 	if (_parts & RectPart::Top) {
 		paintTop(p);
 	}
